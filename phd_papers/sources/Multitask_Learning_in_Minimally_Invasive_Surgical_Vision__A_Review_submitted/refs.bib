@Article{Nwoye_lstm_tool_tracking,
author={Nwoye, Chinedu Innocent
and Mutter, Didier
and Marescaux, Jacques
and Padoy, Nicolas},
title={Weakly supervised convolutional LSTM approach for tool tracking in laparoscopic videos},
journal={International Journal of Computer Assisted Radiology and Surgery},
year={2019},
month={Jun},
day={01},
volume={14},
number={6},
pages={1059-1067},
abstract={Real-time surgical tool tracking is a core component of the future intelligent operating room (OR), because it is highly instrumental to analyze and understand the surgical activities. Current methods for surgical tool tracking in videos need to be trained on data in which the spatial positions of the tools are manually annotated. Generating such training data is difficult and time-consuming. Instead, we propose to use solely binary presence annotations to train a tool tracker for laparoscopic videos.},
issn={1861-6429},
OPTdoi={10.1007/s11548-019-01958-6},
OPTurl={https://doi.org/10.1007/s11548-019-01958-6}
}

